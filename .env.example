# RE:TRY / Next.js / Vercel
# Copie para .env. Nunca envie valores reais ao GitHub.
# Local: SQLite em arquivo. Vercel: use a URL remota libsql://... do banco.
DATABASE_URL=file:./retry.db
DATABASE_AUTH_TOKEN=

# Execute npm run admin:setup para preencher estas três variáveis no .env.
RETRY_ADMIN_EMAIL=
RETRY_ADMIN_PASSWORD_HASH=
AUTH_SECRET=

# Todas as variáveis são privadas do servidor, sem prefixo NEXT_PUBLIC_.
# Consulte VERCEL.md para configurar o banco, aplicar migrations e publicar.
